# Copy to .env (never commit .env). Local dev needs none of this: with
# DATABASE_URL_OWNER unset, the backend starts its own embedded Postgres.

# dev | test | demo | prod. demo and prod refuse to start with default secrets.
APP_ENV=dev

# Owner (migration) connection string, Neon DIRECT connection (not the pooled one).
# Leave unset in dev to use the embedded database.
DATABASE_URL_OWNER=

# Optional: low-privilege app role URL. Derived from the owner URL when unset.
DATABASE_URL=

# Password for the rahat_app role the migration creates.
APP_DB_PASSWORD=

# Signing secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encryption key, base64 of 32 random bytes.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# Port the API listens on.
PORT=8000

# Directory of the built frontend (served by the API). Set in the Docker image.
FRONTEND_DIST=

# Internal mock services (identity, registry, payment, SMS).
MOCK_BASE_URL=http://127.0.0.1:9001

# full | lite. Use lite on hosts with 512 MB of RAM.
AI_PROFILE=full

# Comma-separated feature flags.
FEATURE_FLAGS=

# Optional hosted providers. Leave empty to use the local implementations.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# CI only: Postgres owner URL used by the DB tests.
# TEST_DATABASE_URL_OWNER=postgresql://postgres:postgres@localhost:5432/postgres
