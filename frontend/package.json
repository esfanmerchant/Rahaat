{
  "name": "rahat-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Rahat (Prototype). Citizen PWA and staff console. Not an official service.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:audio": "node scripts/make-audio.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "idb": "8.0.4",
    "openapi-fetch": "0.17.0",
    "preact": "10.29.8",
    "preact-iso": "2.12.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/three": "0.187.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
