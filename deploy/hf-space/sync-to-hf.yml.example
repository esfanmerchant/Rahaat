# Copy to .github/workflows/sync-to-hf.yml to enable. Needs repo secrets:
#   HF_TOKEN  (a Hugging Face token with write access)
# and repo variable HF_SPACE, like "your-username/rahat".
name: sync-to-hf
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Prepend the Space header to README.md
        run: |
          cat deploy/hf-space/README.header.md README.md > /tmp/README.hf.md
          cp /tmp/README.hf.md README.md
      - name: Push to the Space
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          HF_SPACE: ${{ vars.HF_SPACE }}
        run: |
          git config user.email "ci@example.invalid"
          git config user.name "ci"
          git add README.md
          git commit -m "HF header" || true
          git push --force "https://user:${HF_TOKEN}@huggingface.co/spaces/${HF_SPACE}" HEAD:main
